# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Any random string of letters, digits, _ or - (up to 256 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Meera's Telegram chat ID. Leave empty at first: the bot will reply with the ID.
# Several IDs can be comma-separated.
ALLOWED_CHAT_IDS=

# From https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# MIN_NOTE_SCORE=6    (notes scoring below this 0-10 score aren't drafted)
# DRAFT_COUNT=5       (drafts sent per note)
# PORT=5003
